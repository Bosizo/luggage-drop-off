import from "@jac/mobui" { StyleSheet }

def:pub buildStyles() -> any {
    return StyleSheet.create({
        "screen": {"flex": 1, "backgroundColor": "#f7f5ef"},
        "screenContent": {"minHeight": "100%", "paddingTop": 48, "paddingBottom": 36, "gap": 0},
        "nav": {"height": 56, "paddingHorizontal": 24, "flexDirection": "row", "alignItems": "center", "gap": 9, "backgroundColor": "#f7f5ef"},
        "brandMark": {"width": 29, "height": 29, "borderRadius": 10, "backgroundColor": "#197963", "alignItems": "center", "justifyContent": "center"},
        "brandGlyph": {"color": "#ffffff", "fontSize": 18, "fontWeight": "bold"},
        "brandName": {"color": "#183b32", "fontSize": 16, "fontWeight": "bold", "letterSpacing": -0.5},
        "navSpacer": {"flex": 1},
        "navLink": {"color": "#777c74", "fontSize": 12, "marginRight": 12},
        "avatar": {"width": 30, "height": 30, "borderRadius": 15, "backgroundColor": "#e9e1d2", "alignItems": "center", "justifyContent": "center"},
        "avatarText": {"color": "#594935", "fontSize": 12, "fontWeight": "bold"},
        "hero": {"paddingTop": 30, "paddingBottom": 20, "paddingHorizontal": 24, "gap": 10},
        "eyebrow": {"flexDirection": "row", "alignItems": "center", "gap": 7},
        "liveDot": {"width": 7, "height": 7, "borderRadius": 4, "backgroundColor": "#e09b58"},
        "eyebrowText": {"fontSize": 10, "fontWeight": "bold", "letterSpacing": 1.2, "color": "#197963"},
        "heroTitle": {"fontSize": 37, "lineHeight": 42, "fontWeight": "bold", "letterSpacing": -1.4, "color": "#183b32"},
        "heroSubtitle": {"fontSize": 14, "lineHeight": 21, "color": "#777c74", "maxWidth": 360},
        "searchPanel": {"marginHorizontal": 24, "marginBottom": 26, "padding": 15, "borderRadius": 16, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff", "flexDirection": "row", "alignItems": "center", "gap": 14},
        "searchField": {"flex": 1, "gap": 8},
        "fieldLabel": {"fontSize": 9, "fontWeight": "bold", "letterSpacing": 1, "color": "#777c74"},
        "fieldValueRow": {"flexDirection": "row", "alignItems": "center", "gap": 6},
        "pin": {"fontSize": 18, "color": "#197963"},
        "locationInput": {"flex": 1, "height": 25, "padding": 0, "fontSize": 13, "fontWeight": "600", "color": "#183b32"},
        "fieldDivider": {"width": 1, "height": 38, "backgroundColor": "#e8e5dc"},
        "durationField": {"gap": 8},
        "durationRow": {"flexDirection": "row", "alignItems": "center", "gap": 9},
        "stepperButton": {"width": 27, "height": 27, "borderRadius": 9, "borderWidth": 1, "borderColor": "#e8e5dc", "alignItems": "center", "justifyContent": "center"},
        "stepperText": {"fontSize": 17, "color": "#197963"},
        "durationValue": {"fontSize": 12, "fontWeight": "600", "color": "#183b32"},
        "resultsHeader": {"paddingHorizontal": 24, "paddingBottom": 13, "flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "sectionTitle": {"fontSize": 19, "fontWeight": "bold", "letterSpacing": -0.3, "color": "#183b32"},
        "resultSubtitle": {"fontSize": 12, "color": "#777c74", "marginTop": 3},
        "countPill": {"paddingVertical": 6, "paddingHorizontal": 10, "borderRadius": 99, "backgroundColor": "#e9f0e9"},
        "countText": {"fontSize": 11, "fontWeight": "600", "color": "#197963"},
        "list": {"paddingHorizontal": 24, "gap": 11},
        "venueCard": {"padding": 14, "borderRadius": 15, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff", "gap": 11},
        "venueTop": {"flexDirection": "row", "alignItems": "center", "gap": 10},
        "venueIcon": {"width": 40, "height": 40, "borderRadius": 12, "backgroundColor": "#edf1e8", "alignItems": "center", "justifyContent": "center"},
        "venueIconText": {"fontSize": 17, "fontWeight": "bold", "color": "#197963"},
        "venueInfo": {"flex": 1, "gap": 3},
        "venueName": {"fontSize": 14, "fontWeight": "bold", "color": "#183b32"},
        "mutedSmall": {"fontSize": 11, "color": "#777c74"},
        "rating": {"paddingVertical": 5, "paddingHorizontal": 7, "borderRadius": 8, "backgroundColor": "#f8f4e9"},
        "ratingText": {"fontSize": 11, "fontWeight": "bold", "color": "#9a733c"},
        "venueMeta": {"flexDirection": "row", "alignItems": "center", "gap": 8, "paddingLeft": 50},
        "verifiedPill": {"paddingVertical": 4, "paddingHorizontal": 6, "borderRadius": 5, "backgroundColor": "#e9f3ed"},
        "verifiedText": {"fontSize": 8, "fontWeight": "bold", "letterSpacing": 0.8, "color": "#197963"},
        "cardFooter": {"paddingTop": 10, "borderTopWidth": 1, "borderTopColor": "#f0eee8", "flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "price": {"fontSize": 11, "color": "#777c74"},
        "priceValue": {"fontSize": 17, "fontWeight": "bold", "color": "#183b32"},
        "categoryText": {"fontSize": 10, "color": "#777c74", "marginTop": 3},
        "reserveButton": {"paddingVertical": 9, "paddingHorizontal": 16, "borderRadius": 9, "backgroundColor": "#197963", "alignItems": "center"},
        "reserveButtonText": {"fontSize": 12, "fontWeight": "bold", "color": "#ffffff"},
        "successCard": {"marginHorizontal": 24, "marginBottom": 14, "padding": 14, "borderRadius": 14, "borderWidth": 1, "borderColor": "#c5dfcc", "backgroundColor": "#edf6ef", "flexDirection": "row", "alignItems": "center", "gap": 11},
        "successIcon": {"width": 30, "height": 30, "borderRadius": 15, "backgroundColor": "#d8ebdc", "alignItems": "center", "justifyContent": "center"},
        "successCheck": {"fontSize": 17, "fontWeight": "bold", "color": "#197963"},
        "successCopy": {"flex": 1, "gap": 3},
        "successTitle": {"fontSize": 13, "fontWeight": "bold", "color": "#183b32"},
        "successSubtitle": {"fontSize": 10, "color": "#777c74"},
        "successTotal": {"fontSize": 16, "fontWeight": "bold", "color": "#197963"},
        "emptyCard": {"marginHorizontal": 24, "padding": 24, "alignItems": "center", "gap": 8, "borderRadius": 14, "backgroundColor": "#ffffff"},
        "emptyTitle": {"fontSize": 15, "fontWeight": "bold", "color": "#183b32"},
        "trustLine": {"paddingTop": 21, "paddingHorizontal": 24, "alignItems": "center"},
        "trustText": {"fontSize": 8, "letterSpacing": 1, "color": "#777c74", "textAlign": "center"},
        "modeRow": {"flexDirection": "row", "gap": 8, "paddingHorizontal": 24, "paddingBottom": 16},
        "modeButton": {"paddingVertical": 8, "paddingHorizontal": 13, "borderRadius": 20, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff"},
        "modeActive": {"paddingVertical": 8, "paddingHorizontal": 13, "borderRadius": 20, "backgroundColor": "#197963"},
        "modeText": {"fontSize": 11, "fontWeight": "600", "color": "#183b32"},
        "modeTextActive": {"fontSize": 11, "fontWeight": "600", "color": "#ffffff"},
        "destinationRow": {"paddingHorizontal": 24, "paddingBottom": 16, "flexDirection": "row", "gap": 8},
        "destinationButton": {"paddingVertical": 8, "paddingHorizontal": 10, "borderRadius": 10, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff"},
        "destinationActive": {"paddingVertical": 8, "paddingHorizontal": 10, "borderRadius": 10, "backgroundColor": "#e9f3ed", "borderWidth": 1, "borderColor": "#197963"},
        "destinationText": {"fontSize": 10, "fontWeight": "600", "color": "#777c74"},
        "destinationTextActive": {"fontSize": 10, "fontWeight": "bold", "color": "#197963"},
        "bookingHeader": {"paddingHorizontal": 24, "paddingTop": 16, "paddingBottom": 10},
        "bookingCard": {"marginHorizontal": 24, "marginBottom": 10, "padding": 14, "borderRadius": 14, "borderWidth": 1, "borderColor": "#c5dfcc", "backgroundColor": "#edf6ef", "flexDirection": "row", "alignItems": "center", "gap": 10},
        "cancelButton": {"paddingVertical": 8, "paddingHorizontal": 10, "borderRadius": 8, "borderWidth": 1, "borderColor": "#d9aaa0", "backgroundColor": "#ffffff"},
        "cancelText": {"fontSize": 10, "fontWeight": "bold", "color": "#a44737"},
        "partnerHero": {"paddingTop": 20, "paddingBottom": 18, "paddingHorizontal": 24, "gap": 8},
        "partnerTitle": {"fontSize": 28, "lineHeight": 34, "fontWeight": "bold", "letterSpacing": -0.8, "color": "#183b32"},
        "metricRow": {"paddingHorizontal": 24, "flexDirection": "row", "gap": 10},
        "metricCard": {"flex": 1, "padding": 14, "borderRadius": 14, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff", "gap": 7},
        "metricValue": {"fontSize": 23, "fontWeight": "bold", "color": "#183b32"},
        "metricLabel": {"fontSize": 10, "color": "#777c74"},
        "partnerSection": {"paddingHorizontal": 24, "paddingTop": 22, "paddingBottom": 10},
        "partnerVenue": {"marginHorizontal": 24, "marginBottom": 10, "padding": 14, "borderRadius": 14, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff", "gap": 10},
        "partnerRow": {"flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "partnerRevenue": {"fontSize": 16, "fontWeight": "bold", "color": "#197963"},
        "cityMenu": {"marginHorizontal": 24, "marginTop": -16, "marginBottom": 20, "padding": 12, "borderRadius": 14, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff", "gap": 4, "maxHeight": 270, "overflow": "scroll"},
        "cityOption": {"paddingVertical": 10, "paddingHorizontal": 8, "borderBottomWidth": 1, "borderBottomColor": "#f0eee8"},
        "cityOptionText": {"fontSize": 13, "color": "#183b32"},
        "airportSearch": {"height": 40, "paddingHorizontal": 10, "marginVertical": 8, "borderRadius": 9, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff", "fontSize": 13, "color": "#183b32"},
        "bagPanel": {"marginHorizontal": 24, "marginBottom": 12, "padding": 14, "borderRadius": 14, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff", "flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "bagInfo": {"gap": 4},
        "totalCard": {"marginHorizontal": 24, "marginBottom": 5, "paddingHorizontal": 16, "paddingVertical": 12, "borderRadius": 12, "backgroundColor": "#e9f3ed", "flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "totalCaption": {"fontSize": 11, "color": "#777c74", "marginTop": 3},
        "totalPrice": {"fontSize": 23, "fontWeight": "bold", "color": "#197963"},
        "weightDisclaimer": {"marginHorizontal": 24, "marginTop": 14, "marginBottom": 24, "padding": 12, "borderRadius": 10, "backgroundColor": "#f1eee5", "fontSize": 11, "lineHeight": 16, "color": "#686b64"},
        "reserveGroup": {"alignItems": "flex-end", "gap": 4},
        "cardTotal": {"fontSize": 11, "fontWeight": "bold", "color": "#197963"},
        "backButton": {"marginHorizontal": 24, "marginTop": 10, "paddingVertical": 10},
        "backText": {"fontSize": 12, "fontWeight": "600", "color": "#197963"},
        "checkoutSummary": {"marginHorizontal": 24, "marginBottom": 18, "padding": 16, "borderRadius": 15, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff", "gap": 8},
        "checkoutCopy": {"fontSize": 12, "lineHeight": 18, "color": "#777c74"},
        "checkoutRule": {"height": 1, "backgroundColor": "#e8e5dc", "marginVertical": 5},
        "checkoutRow": {"flexDirection": "row", "alignItems": "center", "justifyContent": "space-between"},
        "checkoutTotal": {"fontSize": 23, "fontWeight": "bold", "color": "#197963"},
        "paymentSection": {"paddingHorizontal": 24, "paddingBottom": 12, "gap": 4},
        "paymentOption": {"marginHorizontal": 24, "marginBottom": 8, "padding": 13, "borderRadius": 12, "borderWidth": 1, "borderColor": "#e8e5dc", "backgroundColor": "#ffffff", "flexDirection": "row", "alignItems": "center", "gap": 11},
        "paymentRadio": {"width": 22, "height": 22, "borderRadius": 11, "borderWidth": 1, "borderColor": "#197963", "alignItems": "center", "justifyContent": "center"},
        "paymentRadioText": {"fontSize": 13, "color": "#197963"},
        "paymentName": {"fontSize": 13, "fontWeight": "bold", "color": "#183b32"},
        "checkoutButton": {"marginHorizontal": 24, "marginTop": 12, "paddingVertical": 15, "paddingHorizontal": 16, "borderRadius": 11, "backgroundColor": "#197963", "alignItems": "center"},
        "checkoutSuccess": {"marginHorizontal": 24, "marginTop": 32, "padding": 22, "borderRadius": 16, "backgroundColor": "#edf6ef", "alignItems": "center", "gap": 12},
        "checkoutTitle": {"fontSize": 22, "fontWeight": "bold", "color": "#183b32"}
    });
}
